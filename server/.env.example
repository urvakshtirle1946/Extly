PORT=4000
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key
NVIDIA_API_KEY=your_nvidia_api_key
TOGETHER_API_KEY=your_together_api_key
# Used automatically when primary providers return quota or rate-limit errors.
QWEN_CLOUD_API_KEY=your_qwen_cloud_api_key_here
# Use the endpoint for the region where the Qwen Cloud key was created.
QWEN_CLOUD_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CLOUD_MODEL=qwen3-coder-plus
# A long random value required by the private /admin panel (never expose this in NEXT_PUBLIC variables).
ADMIN_SECRET_KEY=replace_with_a_long_random_secret
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

